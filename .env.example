# PostgreSQL connection used by the HTTP and WebSocket backends.
DATABASE_URL=

# At least 32 random characters each. Rotate JWT_SECRET deliberately: doing so
# invalidates every active access token. OAUTH_BACKEND_SHARED_SECRET must match
# the Next.js and HTTP backend deployments.
JWT_SECRET=
OAUTH_BACKEND_SHARED_SECRET=

# Comma-separated browser origins permitted to call the HTTP API and open a
# WebSocket connection.
ALLOWED_ORIGINS=http://localhost:3000

# Server-only URL used by NextAuth to exchange a verified OAuth assertion.
HTTP_BACKEND_URL=http://localhost:3001

# Required only when the corresponding OAuth provider is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_SECRET=
